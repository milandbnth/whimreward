{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022"],
        "types": ["node"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["index.js", "index.d.ts", "core/**/*", "test/**/*"],
    "exclude": ["node_modules"]
}
