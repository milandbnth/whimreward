DATABASE_URL=postgresql://username:password@host:5432/database

SESSION_SECRET=replace_with_a_random_secret

WHIMSTACK_API_SECRET=replace_with_a_long_random_secret

# Oracle Autonomous Database connections (local wallet directories)
WHIMDB_CONNECT_STRING=whimdb_low
WHIMDB_WALLET_DIR=/path/to/Wallet_whimdb
WHIMTRX_CONNECT_STRING=whimtrx_low
WHIMTRX_WALLET_DIR=/path/to/Wallet_whimtrx
WHIMDB_USER=your_whimdb_username
WHIMDB_PASSWORD=your_whimdb_password
WHIMTRX_USER=your_whimtrx_username
WHIMTRX_PASSWORD=your_whimtrx_password
