{
    "name": "@joelouf/ledger-system",
    "version": "1.0.1",
    "description": "A zero-dependency, append-only ledger engine that derives every balance, status, P&L, and deposit figure as a deterministic fold over one immutable transaction log.",
    "type": "module",
    "main": "index.js",
    "module": "index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "import": "./index.js",
            "types": "./index.d.ts"
        },
        "./core": {
            "import": "./core/index.js",
            "types": "./core/index.d.ts"
        }
    },
    "files": [
        "index.js",
        "index.d.ts",
        "core/",
        "SECURITY.md"
    ],
    "keywords": [
        "ledger",
        "double-entry",
        "accounting",
        "append-only",
        "audit-trail",
        "zero-dependencies",
        "property-finance",
        "reconciliation",
        "deterministic",
        "financial-engine"
    ],
    "author": "joelouf",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/joelouf/ledger-system.git"
    },
    "homepage": "https://github.com/joelouf/ledger-system#readme",
    "bugs": {
        "url": "https://github.com/joelouf/ledger-system/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.32.1",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "node --test test/*.test.js",
        "typecheck": "tsc"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "typescript": "^5.9.0"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^17.4.2",
        "express": "^5.3.0",
        "express-session": "^1.19.0",
        "oracledb": "^26.0.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "bcrypt",
            "oracledb"
        ]
    }
}
